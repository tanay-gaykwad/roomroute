# Local Docker Compose values only. Replace both before any shared deployment.
POSTGRES_PASSWORD=roomroute-local-only
REDIS_PASSWORD=roomroute-local-only

# Production environment (managed secrets, not committed):
# APP_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/roomroute?sslmode=require
# ROOMROUTE_DB_POOL_SIZE=20
# REDIS_URL=rediss://:PASSWORD@HOST:PORT/0
# ROOMROUTE_PUBLIC_URL=https://roomroute.example
# ROOMROUTE_ALLOWED_HOSTS=roomroute.example
# ROOMROUTE_TRUST_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
# SMTP_HOST=smtp.example
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM=RoomRoute <no-reply@example>

